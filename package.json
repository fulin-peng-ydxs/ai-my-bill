{
  "name": "my-bill",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11.6.2 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "bootstrap": "npm --prefix app ci --ignore-scripts",
    "check": "bash scripts/ios-app.sh common",
    "build": "npm --prefix app run native:sync",
    "ios:open": "npm --prefix app run ios:open",
    "check:app": "bash scripts/ios-app.sh common",
    "build:ios-app": "bash scripts/ios-app.sh ios-build",
    "check:ios-app:simulator": "bash scripts/ios-app.sh ios-smoke",
    "check:ios-app:touch": "bash scripts/ios-app.sh ios-touch",
    "debug:ios-app": "bash scripts/ios-app.sh debug",
    "ci:ios-app": "bash scripts/ios-ci.sh",
    "setup:local": "bash scripts/ios-local.sh setup",
    "verify:local": "bash scripts/ios-local.sh verify",
    "status:local": "bash scripts/ios-local.sh status",
    "push:local": "bash scripts/ios-local.sh push"
  }
}
