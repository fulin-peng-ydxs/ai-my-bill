      ]
    },
    {
      "paths": [
        "app/src/data/**",
        "app/src/domain/**",
        "app/src/platform/**",
        "app/native-tests/**",
        "app/test-support/**",
        "app/ios/**",
        "app/package*.json",
        "app/vitest.config.ts",
        "app/src/main.ts",
        "app/src/App.vue",
        "scripts/lib/ios-scale*",
        "scripts/lib/ios-capacity*",
        "scripts/toolchain.sh",
        "app/src/views/ReportView.vue",
        "app/src/views/LedgerView.vue",
        "app/src/components/Report*",
        "app/src/stores/bootstrap.ts",
        "app/src/api/**",
        "app/src/composables/useReport*",
        "app/src/composables/reportChartRuntime.ts",
        "app/src/composables/useIncrementalLedgerQuery.ts"
