  "supersedes": {
    "app-common": [
      "scripts"
    ],
    "native-build": [
      "scripts-macos"
    ],
    "touch": [
      "ui-entry",
      "ui-personal",
      "ui-lifecycle",
      "ui-query",
      "ui-query-input",
      "ui-reports",
      "ui-merge",
      "ui-paging",
      "ui-unit-paging",
      "ui-dictionary-0",
      "ui-dictionary-1",
      "ui-dictionary-2",
      "ui-dictionary-3",
      "ui-dictionary-4",
      "ui-dictionary-5",
      "ui-dictionary-6",
      "ui-dictionary-7",
      "ui-report-dimensions",
      "ui-data-management",
      "ui-ios-interaction"
    ]
  },
  "scriptSkips": {
    "linux": [
      "T12 真实 CLI 换库后 cancelled 保留意图且停止续发，下轮先恢复再准备",
      "T12 真实 CLI 换库后 timed-out 保留意图且停止续发，下轮先恢复再准备",
      "真实 CLI 成对恢复局部入口只接受受管阶段，结束后回收活动许可并生成可用证据",
      "原生场景 CLI 把具体场景传入测试阶段及最终回执，受控工具替身不启动设备",
      "UI 局部 CLI 只在夹具关闭后预启动，runner 准备复用前台 App，不扩大用例",
      "runner 安装失败后 App 回执仍有效，重试只装 runner；旧整体安装失败仍保留完整锁",
      "新候选 App 在卸载前拒绝错误沙盒回执，保留有效安装、基线和中断日志",
      "同会话 UI/Release→App/Debug→UI/Release 统一登记且热缓存恢复，探针安装失败=false",
      "同会话 UI/Release→App/Debug→UI/Release 统一登记且热缓存恢复，探针安装失败=true",
      "完整入口借用会话共用安装校验，只有卸载成功才失效登记，不误拦返回局部",
      "创建失败补偿共享 10 秒清理预算，耗尽时不再叠加一次强杀宽限"
    ]
  },
  "unknownSource": {
    "paths": [
      "app/src/**"
    ],
    "exclude": [
      "**/*.spec.ts",
      "**/*.d.ts",
      "app/src/api/generated/**"
    ],
    "suites": [
      "native-sqlite",
      "scale-10000",
      "scale-100000"
    ]
  },
  "onDemandSuites": [
    "touch",
    "scale-10000",
    "scale-100000",
    "install-gate"
  ]
}
