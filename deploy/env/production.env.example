# 生产环境非密钥配置示例。真实密码仅保存在宿主机 0600 secret 文件，不写入本文件、镜像或 Git。
POSTGRES_DB=my_bill
MY_BILL_MIGRATION_DB_URL=jdbc:postgresql://db:5432/my_bill
MY_BILL_MIGRATION_DB_USERNAME=my_bill_migration
MY_BILL_MIGRATION_DB_PASSWORD_FILE=/run/secrets/migration_db_password
MY_BILL_APP_DB_URL=jdbc:postgresql://db:5432/my_bill
MY_BILL_APP_DB_USERNAME=my_bill_app
MY_BILL_APP_DB_PASSWORD_FILE=/run/secrets/app_db_password
MY_BILL_POSTGRES_ADMIN_PASSWORD_HOST_FILE=/etc/my-bill/secrets/postgres_admin_password
MY_BILL_MIGRATION_DB_PASSWORD_HOST_FILE=/etc/my-bill/secrets/migration_db_password
MY_BILL_APP_DB_PASSWORD_HOST_FILE=/etc/my-bill/secrets/app_db_password
MY_BILL_AUTH_RATE_LIMIT_PEPPER_HOST_FILE=/etc/my-bill/secrets/auth_rate_limit_pepper
MY_BILL_SERVER_PORT=8080
