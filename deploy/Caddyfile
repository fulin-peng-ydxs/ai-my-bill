{
	# 独立内部 CA 在受控签发端保存；代理只加载叶证书，不自动生成另一套根证书。
	auto_https off
	admin localhost:2019
	servers {
		protocols h1 h2
	}
}

https://:8443 {
	tls /etc/my-bill/tls/server.crt /etc/my-bill/tls/server.key
	@outside not remote_ip {$MY_BILL_ALLOWED_CIDRS}
	route {
		respond @outside 403
		header {
			-Server
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), geolocation=(), microphone=()"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		}
		handle /api/* {
			header Cache-Control "no-store"
			reverse_proxy app:{$MY_BILL_SERVER_PORT:8080} {
				# 不把客户端伪造的转发头传给应用。应用仍以服务端认证上下文确定身份/租户。
				header_up -Forwarded
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
			}
		}
		handle {
			root * /srv
			# 导航/manifest/SW 重新验证，避免发布后仍返回旧外壳；API 永不进入静态回退。
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
