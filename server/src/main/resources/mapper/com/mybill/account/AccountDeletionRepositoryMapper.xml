<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mybill.account.AccountDeletionRepositoryMapper">
  <select id="lockUser" resultType="map">
    SELECT id,tenant_id,username,status,credential_version FROM app_user
    WHERE id=#{p.userId} AND role='USER' AND status&lt;&gt;'DELETED' FOR UPDATE
  </select>
  <select id="exportLocations" resultType="map">
    SELECT file_location FROM export_job WHERE user_id=#{p.userId} AND file_location IS NOT NULL FOR UPDATE
  </select>
  <select id="exportLocationExists" resultType="map">
    SELECT EXISTS(SELECT 1 FROM export_job WHERE file_location=#{p.location})
  </select>
  <insert id="insertDeletionJob">
    INSERT INTO account_deletion_job(tenant_id,id,user_id,status,requested_at,created_at,updated_at)
    VALUES(current_setting('app.tenant_id')::uuid,#{p.id},#{p.userId},'RUNNING',#{p.now},#{p.now},#{p.now})
  </insert>
  <insert id="insertAudit">
    INSERT INTO account_deletion_audit(id,actor_type,subject_digest,status,requested_at,executed_at,expires_at,result_summary,created_at)
    VALUES(#{p.id},#{p.actorType},#{p.subjectDigest},'SUCCEEDED',#{p.now},#{p.now},#{p.expiresAt},'ONLINE_DATA_ERASED',#{p.now})
  </insert>
  <delete id="deleteAdjustments">DELETE FROM expense_adjustment WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteTemplates">DELETE FROM daily_entry_template WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteLedger">DELETE FROM ledger_entry WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteProductMergeEvents">DELETE FROM product_merge_event WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteProducts">DELETE FROM product WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deletePreferences">DELETE FROM user_preference WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteIdempotency">DELETE FROM idempotency_record WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteExports">DELETE FROM export_job WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteExpenseCategories">DELETE FROM expense_category WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteUnits">DELETE FROM unit WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteFundingChannels">DELETE FROM funding_channel WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deletePurchaseChannels">DELETE FROM purchase_channel WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteLocationLabels">DELETE FROM location_label WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteIncomeCategories">DELETE FROM income_category WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deletePayers">DELETE FROM payer WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteDeletionJobs">DELETE FROM account_deletion_job WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteJobRuns">DELETE FROM job_run WHERE tenant_id=#{p.tenantId}</delete>
  <delete id="deleteSessions">DELETE FROM user_session WHERE user_id=#{p.userId}</delete>
  <update id="anonymizePriorAdminAudits">
    UPDATE admin_audit_log SET object_id=#{p.reference},safe_summary='{}'::jsonb
    WHERE object_type='USER' AND object_id=#{p.userId}::text
  </update>
  <delete id="deleteUser">DELETE FROM app_user WHERE id=#{p.userId} AND role='USER'</delete>
  <delete id="deleteTenant">DELETE FROM tenant WHERE id=#{p.tenantId}</delete>
  <delete id="purgeExpiredAudits">
    DELETE FROM account_deletion_audit WHERE id IN (
      SELECT id FROM account_deletion_audit WHERE expires_at&lt;=#{p.now} ORDER BY expires_at,id LIMIT #{p.limit}
    )
  </delete>
</mapper>
