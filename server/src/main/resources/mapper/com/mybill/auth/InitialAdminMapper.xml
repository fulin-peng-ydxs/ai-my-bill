<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mybill.auth.InitialAdminMapper">
  <!-- 仅新库上线时执行，与首管理员及审计写入同一事务；重复运行失败且不修改已有账号。 -->
  <update id="lockAccounts">LOCK TABLE app_user IN EXCLUSIVE MODE</update>
  <select id="countAccounts" resultType="long">SELECT count(*) FROM app_user</select>
  <insert id="insert">
    INSERT INTO app_user(id,username,password_digest,temporary_password_expires_at,role,status,credential_version)
    VALUES (#{id},#{username},#{digest},#{expiresAt},'ADMIN','ACTIVE',1)
  </insert>
  <insert id="audit">
    INSERT INTO admin_audit_log(id,administrator_user_id,action,object_type,object_id,result,safe_summary,occurred_at)
    VALUES (#{id},#{adminId},'BOOTSTRAP_ADMIN','USER',CAST(#{adminId} AS varchar),'SUCCEEDED','{}',CURRENT_TIMESTAMP)
  </insert>
</mapper>
