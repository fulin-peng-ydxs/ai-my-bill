<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mybill.dictionary.IncomeDictionaryServiceMapper">
  <select id="lock" resultType="map">
    SELECT id, display_name FROM
    <choose>
      <when test="p.type == 'PAYER'">payer</when>
      <when test="p.type == 'INCOME_CATEGORY'">income_category</when>
      <when test="p.type == 'FUNDING_CHANNEL'">funding_channel</when>
      <otherwise>unsupported_dictionary_type</otherwise>
    </choose>
    WHERE id = #{p.id} AND status = 'ACTIVE' FOR SHARE
  </select>
</mapper>
