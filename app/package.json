{
  "name": "@my-bill/ios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "native:sync": "npm run build && node ../scripts/normalize-capacitor-spm.mjs --prepare && cap sync ios && node ../scripts/normalize-capacitor-spm.mjs",
    "probe:bundle": "vite build --config native-tests/vite.config.ts",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "echarts": "6.1.0",
    "lucide-vue-next": "0.468.0",
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.11"
  }
}
