# 本地开发模板：复制到 .local/dev.env 后由开发入口自动加载；根 .env 不加载。
# Shell 已导出的同名变量优先；仅支持单行 KEY=value，不执行命令或展开 $变量。
# 生产环境必须由部署环境提供真实凭据，不读取本文件或 .local/dev.env。
MY_BILL_SERVER_PORT=8080
# 开发与本地预览监听所有 IPv4 地址；仅本机访问时显式设置 127.0.0.1。
MY_BILL_WEB_HOST=0.0.0.0
MY_BILL_WEB_PORT=5174
MY_BILL_JOB_POLL_DELAY_MS=5000
MY_BILL_JOB_MAX_TASKS_PER_POLL=20
MY_BILL_DB_HOST=127.0.0.1
MY_BILL_DB_PORT=54329
MY_BILL_DB_NAME=my_bill_dev
MY_BILL_DB_ADMIN_USER=my_bill_dev
MY_BILL_DB_MIGRATION_USER=my_bill_migration
MY_BILL_DB_MIGRATION_PASSWORD=
MY_BILL_DB_APP_USER=my_bill_app
MY_BILL_DB_APP_PASSWORD=
MY_BILL_DB_POOL_MAX_SIZE=5
MY_BILL_DB_POOL_MIN_IDLE=1
MY_BILL_DB_CONNECTION_TIMEOUT_MS=5000
