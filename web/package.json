{
  "name": "@my-bill/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "dev": "vite --port ${MY_BILL_WEB_PORT:-5174}",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "contract:lint": "redocly lint --config ../contracts/redocly.yaml ../contracts/openapi.yaml",
    "contract:generate": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.ts",
    "contract:check": "npm run contract:lint && npm run contract:generate && git diff --exit-code -- src/api/generated/schema.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run contract:check && npm run build"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@redocly/cli": "^1.34.5",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.1",
    "yaml": "^2.9.0"
  }
}
